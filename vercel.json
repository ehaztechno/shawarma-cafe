{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|src/assets/|__/|sw\\.js|workbox-|manifest\\.webmanifest|favicon\\.ico|icon\\.svg|apple-touch-icon\\.png|pwa-).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
